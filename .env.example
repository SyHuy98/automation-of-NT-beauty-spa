# ---- Bắt buộc cho web app (Vercel + local) ----
# Lấy ở Supabase Dashboard → Project Settings → API (URL + publishable/anon key).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# ---- Chỉ dùng cho script chạy tay ở máy bạn (KHÔNG khai báo trên Vercel, KHÔNG có tiền tố NEXT_PUBLIC_) ----
# Dùng bởi `npm run create-owner`. Lấy ở Project Settings → API → service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Web Push (VAPID) ----
# Không bắt buộc: Edge Function `send-push` tự sinh cặp khoá lần đầu và lưu trong
# bảng private.config (không ra khỏi database). Chỉ điền nếu muốn dùng cặp khoá riêng,
# sau đó chạy SQL: select public.internal_set_config(...) bằng service role.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://<ten-mien-cua-ban>
